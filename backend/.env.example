# Copiar a .env y completar. Solo figuran las variables que el codigo lee.

# --- App ---
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://usuario:clave@host:5432/base
JWT_SECRET=cambiar-por-un-secreto-largo
# Opcional: rondas de bcrypt (por defecto 10 en produccion, 8 en desarrollo)
# BCRYPT_SALT_ROUNDS=10

# --- Imagenes de ejercicios (Supabase Storage) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=

# --- Seed (npm run seed): crea el admin inicial ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Pruebas de carga (npm run load:test:*) ---
API_URL=http://localhost:3000
LOAD_CONCURRENCY=50
LOAD_DURATION_SEC=30
LOAD_LOGIN_EMAIL=
LOAD_LOGIN_PASSWORD=
